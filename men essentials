<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Men's Essentials</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f8f8f8;
      color: #222;
    }

    header {
      background: white;
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    header h1 {
      font-size: 24px;
      margin-bottom: 15px;
    }

    nav a {
      margin: 0 10px;
      color: #222;
      text-decoration: none;
      font-size: 14px;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    h2 {
      text-align: center;
      margin-bottom: 25px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .product {
      background: white;
      border: 1px solid #eee;
      border-radius: 10px;
      padding: 15px;
      text-align: center;
    }

    .product img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
      background: #f5f5f5;
    }

    .product h3 {
      font-size: 16px;
      margin: 12px 0;
    }

    .buy {
      display: inline-block;
      background: #111;
      color: white;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 6px;
      font-size: 13px;
    }

    .buy:hover {
      background: #333;
    }

    @media (max-width: 600px) {
      .products {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>

<body>

<header>
  <h1>YOUR BRAND</h1>

  <nav>
    <a href="index.html">Home</a>
    <a href="women.html">Women</a>
    <a href="men.html">Men</a>
    <a href="fragrance.html">Fragrance</a>
  </nav>
</header>

<div class="container">

  <h2>Men's Essentials</h2>

  <div class="products">

    <div class="product">
      <img src="YOUR-IMAGE-URL" alt="Product 1">
      <h3>Product Name</h3>

      <a href="YOUR-AMAZON-AFFILIATE-LINK"
         target="_blank"
         class="buy">
        Shop Now
      </a>
    </div>

    <div class="product">
      <img src="YOUR-IMAGE-URL" alt="Product 2">
      <h3>Product Name</h3>

      <a href="YOUR-AMAZON-AFFILIATE-LINK"
         target="_blank"
         class="buy">
        Shop Now
      </a>
    </div>

    <div class="product">
      <img src="YOUR-IMAGE-URL" alt="Product 3">
      <h3>Product Name</h3>

      <a href="YOUR-AMAZON-AFFILIATE-LINK"
         target="_blank"
         class="buy">
        Shop Now
      </a>
    </div>

  </div>

</div>

</body>
</html>
