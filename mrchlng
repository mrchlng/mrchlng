<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Affiliate Store</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f8f8f8;
      color: #222;
    }

    header {
      background: white;
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    header h1 {
      font-size: 24px;
      margin-bottom: 15px;
    }

    nav a {
      margin: 0 10px;
      color: #222;
      text-decoration: none;
      font-size: 14px;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .hero {
      text-align: center;
      margin-bottom: 40px;
    }

    .hero h2 {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .hero p {
      color: #666;
    }

    .categories {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .category {
      background: white;
      border: 1px solid #eee;
      border-radius: 10px;
      padding: 30px 15px;
      text-align: center;
      text-decoration: none;
      color: #222;
      transition: 0.2s;
    }

    .category:hover {
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .category h3 {
      margin-bottom: 8px;
    }

    .category p {
      color: #777;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      .categories {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>YOUR BRAND</h1>

    <nav>
      <a href="index.html">Home</a>
      <a href="women.html">Women</a>
      <a href="men.html">Men</a>
      <a href="fragrance.html">Fragrance</a>
    </nav>
  </header>

  <div class="container">

    <section class="hero">
      <h2>Discover Your Favorites</h2>
      <p>Curated products for women, men, and fragrance lovers.</p>
    </section>

    <section class="categories">

      <a href="women.html" class="category">
        <h3>Women's Essentials</h3>
        <p>Explore women's products</p>
      </a>

      <a href="men.html" class="category">
        <h3>Men's Essentials</h3>
        <p>Explore men's products</p>
      </a>

      <a href="fragrance.html" class="category">
        <h3>Fragrance</h3>
        <p>Explore fragrances</p>
      </a>

    </section>

  </div>

</body>
</html>
